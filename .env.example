# Kopyala: .env.local (repoya girmez). Ayrıntı: docs/SPEC.md Bölüm 9.
# Değerleri buraya YAZMA; bu dosya yalnızca anahtar listesidir.

# Supabase (istemci + sunucu)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase servis istemcisi (yalnızca sunucu)
SUPABASE_SECRET_KEY=

# OpenRouter: Claude Haiku 5.5 + MAI-Transcribe-2 (yalnızca sunucu)
OPENROUTER_API_KEY=

# Speechify (yalnızca sunucu)
SPEECHIFY_API_KEY=

# Vercel Cron yetkilendirmesi (yalnızca sunucu)
CRON_SECRET=

# Uygulama
APP_URL=
CONSENT_VERSION=
